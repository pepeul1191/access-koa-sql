{
  "name": "access-koa",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev-expp": "npx nodemon server.js --ignore public/* --ignore src/*",
    "prepare:sessions": "node -e \"require('fs').mkdirSync('sessions', { recursive: true })\"",
    "dev": "npm run prepare:sessions & npm run dev-expp & npm run svelte",
    "svelte": "rollup -c -w"
  },
  "dependencies": {
    "koa": "^2.15.0",
    "koa-router": "^12.0.1",
    "koa-session": "^6.4.0",
    "koa-connect-flash": "0.1.2",
    "koa-views": "^8.1.0",
    "koa-static": "^5.0.0",
    "koa-bodyparser": "^4.4.1",
    "koa-morgan": "^1.0.1",

    "axios": "^1.6.0",
    "bootstrap": "^5.3.3",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.9",
    "font-awesome": "^4.7.0",

    "session-file-store": "^1.5.0",
    "sirv-cli": "^2.0.0",

    "svelte": "^4.2.18",
    "svelte-app": "file:",
    "svelte-routing": "^2.13.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "nodemon": "^3.0.1",
    "rollup": "^3.15.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-css-only": "^4.3.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.1.2",
    "svelte-preprocess": "^6.0.3"
  },
